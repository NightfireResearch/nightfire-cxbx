     "name": "skeletonIdx",
     "comment": "index into SkeletonTable; equals nnnn of SKELnnnn"
    },
    {
     "offset": 2,
     "type": "uchar",
     "name": "numBones",
     "comment": ""
    },
    {
     "offset": 3,
     "type": "uchar",
     "name": "numTransBones",
     "comment": "popcount(transMask) in every skeleton; no reader found"
    },
    {
     "offset": 4,
     "type": "uint[3]",
     "name": "transMask",
     "comment": "bit b: bone b has animated translation tracks (AnimFrameCopy 0x14013)"
    },
    {
     "offset": 16,
     "type": "_VECTOR[1]",
     "name": "boneOffset",
     "comment": "[numBones] default local translation, unscaled (AnimFrameCopy 0x13f7c)"
    }
   ]
  },
  {
