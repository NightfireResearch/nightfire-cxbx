// The constructor's stores that depend on the frame rate, computed as it computed them: a duration of whole
// seconds in frames (the frame rate word times the seconds), and per-second rates per frame (_FRAME_RATE times
// the rate over 60, in double precision as the x87 did). The table above holds them at 60 fps.
static void WeaponTable_ApplyFrameRate(weapon_definition_tag *table) {
    uint16_t frames = (uint16_t)FRAME_RATE_INT;    // its low word
    float frameRate = _FRAME_RATE;
    table[53].effectDurationFrames = (int16_t)(frames * 15);
    table[54].effectDurationFrames = (int16_t)(frames * 15);
    table[65].effectDurationFrames = (int16_t)(frames * 60);
    table[75].projectileSpeed = (float)((double)frameRate * 0.4375 / 60.0);
    table[77].projectileSpeed = (float)((double)frameRate * 0.4375 / 60.0);
    table[89].effectDurationFrames = (int16_t)(frames * 15);
    table[91].effectDurationFrames = (int16_t)(frames * 15);
    table[99].projectileSpeed = (float)((double)frameRate * 2.5 / 60.0);
    table[100].projectileSpeed = (float)((double)frameRate * 1.5 / 60.0);
    table[101].projectileSpeed = (float)((double)frameRate * 1.5 / 60.0);
    table[102].projectileSpeed = (float)((double)frameRate * 1.5 / 60.0);
    table[105].effectDurationFrames = (int16_t)(frames * 15);
}
